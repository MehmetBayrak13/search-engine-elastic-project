      "forbidden_error": "Yetki hatası (403): API key'in `{index}` index'i üzerinde okuma yetkisi yok.",
      "not_found_error": "Index bulunamadı (404): `{index}` bulunamadı. Index adlarını ve deployment'ı kontrol edin.",
      "es_error": "Elasticsearch bir hata döndürdü: {status}{detail}",
      "response_decode_error": "Elasticsearch yanıtı çözümlenemedi.",
      "empty_query_warning": "Lütfen aramadan önce bir ürün adı yazın.",
      "no_method_warning": "Normal arama için en az bir arama yöntemi açık olmalı.",
      "settings_changed_info": "Arama ayarları değişti. Sonuçları güncellemek için tekrar arayın.",
      "no_results_info": "Arama tamamlandı — \"{query}\" ile eşleşen bir ürün bulunamadı.",
      "suggestions_unavailable_warning": "Canlı öneriler şu anda alınamadı.",
      "suggestions_min_chars_caption": "Öneriler için en az {min_chars} karakter yazın.",
      "score_disclaimer_caption": "Skor, Elasticsearch relevance değeridir; olasılık yüzdesi değildir.",
      "result_header_query": "\"{query}\" için {total:,} sonuç",
      "result_header_meta": "İlk {shown} sonuç gösteriliyor · Aktif yöntemler: {methods}",
      "system_status_caption": "Elasticsearch: {status}  \n Aranan index sayısı: {index_count}  \n Sonuç limiti: {result_size}  \n Öneri limiti: {suggestion_limit}",
      "pagination_range_indicator": "{start}–{end} arası gösteriliyor",
      "pagination_page_indicator": "Sayfa {current_page} / {total_pages}",
      "pagination_window_notice": "İlk {max_result_window:,} sonuç içinde sayfalama yapılabilir.",
      "pagination_limit_error": "Bu sayfaya ulaşılamıyor: Elasticsearch yalnızca ilk {max_result_window:,} sonuç içinde sayfalamaya izin verir (maksimum sayfa: {max_page})."
    }
  }
}
