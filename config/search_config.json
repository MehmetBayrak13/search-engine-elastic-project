{
  "elasticsearch": {
    "search_indices": ["amazon-products-000003", "amazon-products-000004"],
    "autocomplete_indices": ["amazon-products-autocomplete-000001", "amazon-products-autocomplete-000002"],
    "search_timeout_seconds": 20,
    "autocomplete_timeout_seconds": 10,
    "track_total_hits": true,
    "use_dfs_query_then_fetch": true
  },
  "limits": {
    "result_size": 20,
    "autocomplete_fetch_size": 15,
    "autocomplete_display_size": 5,
    "autocomplete_min_chars": 3,
    "autocomplete_cache_ttl_seconds": 30
  },
  "pagination": {
    "enabled": true,
    "page_size": 20,
    "max_result_window": 10000,
    "max_visible_pages": 7
  },
  "search_methods": {
    "exact_asin": { "field": "parent_asin", "boost": 25 },
    "phrase": { "field": "title", "boost": 10 },
    "fuzzy": {
      "type": "best_fields",
      "operator": "and",
      "fuzziness": "AUTO",
      "prefix_length": 2,
      "max_expansions": 30,
      "boost": 1,
      "fields": {
        "title": 6,
        "title.tr": 5,
        "categories_text": 2,
        "categories_text.tr": 2
      }
    },
    "autocomplete": {
      "field": "title.autocomplete",
      "operator": "and"
    }
  },
  "translation": {
    "enabled": true,
    "autocomplete_enabled": true,
    "file": "config/query_translations.json",
    "source_language": "tr",
    "target_language": "en",
    "max_variants": 3,
    "phrase_boost": 6,
    "token_boost": 2,
    "min_query_length": 2,
    "cache_ttl_seconds": 300
  },
  "dynamic_intent": {
    "enabled": true,
    "cache_ttl_seconds": 300,
    "max_category_candidates": 5,
    "minimum_query_length": 3,
    "aggregation_size": 10,
    "boost": 8,
    "timeout_seconds": 5,
    "search_fields": {
      "title": 4,
      "categories_text": 6,
      "categories_text.tr": 5
    },
    "aggregation_fields": [
      "categories",
      "main_category",
      "source_category",
      "store"
    ],
    "negative_category_penalty": 0.5
  },
  "quality_ranking": {
    "enabled": false,
    "score_field": "data_quality_score",
    "consistency_field": "title_category_consistency",
    "boost": 3,
    "consistency_boost": 4,
    "low_consistency_threshold": 0.3,
    "low_consistency_penalty": 0.5,
    "bypass_for_exact_asin": true,
    "missing_value_behavior": "neutral",
    "discovery_filter_enabled": false,
    "discovery_min_data_quality_score": 0.3
  },
  "popularity_ranking": {
    "enabled": true,
    "field": "rating_number",
    "factor": 0.03,
    "baseline": 1.0
  },
  "unit_matching": {
    "enabled": true,
    "fields": ["title", "features"],
    "boost": 2.5,
    "min_query_length": 3
  },
  "rating_sort": {
    "minimum_votes": 50,
    "prior_rating": 3.5
  },
  "alternate_sort": {
    "enabled": true,
    "min_score_ratio": 0.35
  },
  "accessory_penalty": {
    "enabled": true,
    "penalty": 0.4,
    "terms": [
      "sticker", "stickers", "skin", "skins", "decal", "decals", "wrap", "wraps",
      "case", "cases", "cover", "covers", "pouch", "pouches", "sleeve", "sleeves",
      "protector", "protectors",
      "replacement", "replacements", "spare part", "spare parts", "repair kit",
      "mount", "mounts", "holder", "holders", "stand", "stands",
      "strap", "straps", "charm", "charms",
      "adapter", "adapters", "cable", "cables"
    ]
  },
  "book_title_gate": {
    "enabled": true,
    "categories": ["books", "buy a kindle", "audible audiobooks"],
    "category_field": "main_category",
    "title_field": "title.keyword",
    "asin_field": "parent_asin",
    "fuzziness": "AUTO"
  },
  "title_ranking": {
    "enabled": true,
    "exact_field": "title.keyword",
    "exact_boost": 8.0,
    "prefix_boost": 3.5,
    "prefix_max_expansions": 20
  },
  "intent_ranking": {
    "enabled": true,
    "manual_category_boost_cap": 5.0,
    "dynamic_category_boost_cap": 2.0,
    "negative_penalty_floor": 0.3
  },
  "field_relevance": {
    "enabled": true,
    "operator": "and",
    "fields": {
      "title": 5.0,
      "title.tr": 4.0,
      "features": 3.0,
      "features.tr": 2.5,
      "description": 1.5,
      "description.tr": 1.2,
      "categories_text": 2.0,
      "categories_text.tr": 1.8
    },
    "cross_fields_boost": 3.0,
    "store_boost": 0.5
  },
  "field_consensus": {
    "enabled": true,
    "two_field_boost": 1.15,
    "three_field_boost": 1.30,
    "four_plus_field_boost": 1.45,
    "counted_fields": ["title", "features", "description", "categories_text"]
  },
  "relevance_contradiction": {
    "enabled": true,
    "minimum_conflicting_fields": 2,
    "strong_conflicting_fields": 3,
    "mild_penalty": 0.65,
    "strong_penalty": 0.30,
    "minimum_penalty": 0.15,
    "counted_fields": ["description", "features", "categories_text"]
  },
  "relevance_debug": {
    "explain_top_n": 20
  },
  "source_fields": {
    "search": [
      "parent_asin", "title", "main_category", "categories", "source_category",
      "store", "price", "average_rating", "rating_number", "description",
      "features", "image_url"
    ],
    "suggestions": [
      "parent_asin", "title", "store", "price", "average_rating", "rating_number",
      "image_url", "main_category", "categories", "source_category"
    ]
  },
  "autocomplete_ui": {
    "panel_max_height_px": 360,
    "row_height_px": 56,
    "show_images": true
  },
  "product_url_template": "https://www.amazon.com/dp/{asin}",
  "ui": {
    "hero_logo": "🛍️",
    "hero_title": "Milyonlarca ürün içinde aradığını bul",
    "hero_subtitle": "Yazım hatalarına toleranslı, çok alanlı Elasticsearch ürün araması",
    "search_placeholder": "Örn: wireless headphones",
    "placeholder_image": "https://via.placeholder.com/160x160.png?text=G%C3%B6rsel+Yok",
    "example_queries": ["wireless headphones", "air filter", "smartwatch", "coffee grinder"],
    "debounce_ms": 350,
    "intent_fallback_icon": "🏷️",
    "labels": {
      "search_button": "Ara",
      "settings_panel_title": "🔧 Arama Ayarları",
      "toggle_phrase": "İfade eşleşmesi",
      "toggle_multi_match": "Çok alanlı arama",
      "toggle_fuzzy": "Yazım hatası toleransı",
      "toggle_exact_asin": "ASIN önceliği",
      "toggle_live_suggestions": "Canlı öneriler",
      "system_status_title": "Sistem Durumu",
      "status_connected": "Bağlı",
      "status_ready": "Hazır",
      "suggestion_pick_button": "🔎 Bu ürünü ara",
      "suggestion_open_amazon_button": "Amazon'da aç",
      "suggest_panel_title": "En alakalı öneriler",
      "chip_phrase": "Phrase",
      "chip_multi_match": "Multi-field",
      "chip_fuzzy": "Fuzzy",
      "chip_exact_asin": "Exact ASIN",
      "chip_live_suggestions": "Live suggestions",
      "chip_none": "Aktif yöntem yok",
      "method_phrase": "İfade eşleşmesi",
      "method_multi_match": "Çok alanlı arama",
      "method_fuzzy": "Yazım hatası toleransı",
      "method_exact_asin": "ASIN önceliği",
      "hero_hint_prefix": "Ne arayacağını bilmiyor musun?",
      "hero_hint_cta": "Bir örnek dene: \"{example}\"",
      "empty_state_icon": "🔍",
      "empty_state_title": "Aramaya buradan başla",
      "empty_state_text": "Bir ürün adı yazın ya da örneklerden birini deneyin",
      "zero_state_icon": "📭",
      "zero_state_tip": "Bu, aramanın çalışmadığı anlamına gelmez — kataloğumuzda bu tanımda bir ürün olmayabilir. Yazımı kontrol et ya da daha genel bir kelime dene; yazım hatası toleransı açıkken yakın eşleşmeler de aranır.",
      "zero_state_suggestions_label": "Bunlar ilgini çekebilir:",
      "pagination_prev_button": "← Önceki",
      "pagination_next_button": "Sonraki →"
    },
    "help_text": {
      "toggle_phrase": "Kelimelerin başlıktaki sırasını ödüllendirir.",
      "toggle_multi_match": "Başlık, kategori, açıklama ve özelliklerde arar.",
      "toggle_fuzzy": "Yanlış yazılmış kelimelere yakın sonuçlar bulur.",
      "toggle_exact_asin": "Tam ürün kodu eşleşmesini en üste taşır.",
      "toggle_live_suggestions": "Yazarken en alakalı 5 ürünü gösterir."
    },
    "messages": {
      "config_missing_env": "Elastic Cloud bağlantı bilgileri eksik: **{missing}** ortam değişken(ler)i tanımlı değil. Uygulamayı başlatmadan önce bu değişkenleri ayarlayıp yeniden başlatın.",
      "config_load_error": "Yapılandırma yüklenemedi: {error}",
      "connection_error": "Elastic Cloud'a bağlanılamadı. ELASTICSEARCH_URL değerinin doğru olduğundan ve internet bağlantınızın çalıştığından emin olun.",
      "timeout_error": "Elasticsearch isteği zaman aşımına uğradı. Lütfen tekrar deneyin.",
